# AIDA Agentic AI Platform — Konfiguratsiya
# .env fayliga nusxalang va qiymatlarni sozlang

# ── Provider Settings ───────────────────────────────────────
AIDA_PROVIDER=auto
# auto, ollama, lmstudio, gemini, openai, local

# ── Ollama ───────────────────────────────────────────────────
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# ── LM Studio ───────────────────────────────────────────────
LMSTUDIO_ENABLED=true
LMSTUDIO_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=
LMSTUDIO_TIMEOUT=120

# ── Google Gemini ───────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=60

# ── OpenAI / Compatible ─────────────────────────────────────
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=120

# ── Django ──────────────────────────────────────────────────
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080
DJANGO_SECURE_PROXY_SSL_HEADER=false
DJANGO_PORT=8080
